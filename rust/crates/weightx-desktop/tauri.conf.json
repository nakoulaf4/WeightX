{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeightX",
  "version": "0.4.0",
  "identifier": "org.weightx.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WeightX — Weight-Space Programming Harness",
        "width": 1240,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}